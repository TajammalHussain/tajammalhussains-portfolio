# Copy to .env for local Astro dev (public site build only — never commit the real file).
# The Worker reads its own secrets via Wrangler / Cloudflare env vars, see worker/wrangler.toml.

PUBLIC_SITE_URL=https://tajammalhussains.uk
PUBLIC_API_BASE_URL=http://localhost:8787

# Cloudflare Web Analytics token (public, safe to expose client-side)
PUBLIC_CF_ANALYTICS_TOKEN=

# --- Worker-side secrets (set via `wrangler secret put` in production, and in
#     worker/.dev.vars for local `wrangler dev` — never in this file) ---
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=
# CMS_GITHUB_OAUTH_CLIENT_ID=
# CMS_GITHUB_OAUTH_CLIENT_SECRET=
