{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "Local\\s+http://localhost:4321",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/work",
        "http://localhost:4321/work/approval-workflow-platform",
        "http://localhost:4321/live",
        "http://localhost:4321/live/carbon",
        "http://localhost:4321/live/housing",
        "http://localhost:4321/live/meta",
        "http://localhost:4321/about",
        "http://localhost:4321/cv",
        "http://localhost:4321/api",
        "http://localhost:4321/status",
        "http://localhost:4321/writing"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
