---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StatusWidget from "@/components/StatusWidget.astro";
---

<BaseLayout
  title="System Status"
  description="Pipeline health, data quality check results, and freshness status — real results, including honest failures."
>
  <h1 class="text-3xl font-semibold tracking-tight">System Status</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-fg-muted)]">
    Real data-quality check results per pipeline: freshness, completeness, validity, uniqueness,
    and referential integrity. Failures are shown honestly — a system that never fails a check is
    either trivial or not being checked properly.
  </p>
  <div class="mt-10">
    <StatusWidget />
  </div>
</BaseLayout>
