---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { SITE } from "@/lib/site";

export async function getStaticPaths() {
  const posts = await getCollection(
    "writing",
    (entry: CollectionEntry<"writing">) => !entry.data.draft,
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const pageUrl = new URL(`/writing/${post.slug}`, SITE.url).toString();
const ogImageUrl = new URL(`/og/writing/${post.slug}.png`, SITE.url).toString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.excerpt,
    image: ogImageUrl,
    datePublished: data.publishDate.toISOString(),
    // No separate "last updated" field exists in the content schema yet —
    // defaulting dateModified to publishDate rather than inventing one.
    dateModified: data.publishDate.toISOString(),
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    author: { "@type": "Person", name: "Tajammal Hussain", url: SITE.url },
    publisher: { "@type": "Person", name: "Tajammal Hussain", url: SITE.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Writing", item: "/writing" },
      { "@type": "ListItem", position: 2, name: data.title, item: `/writing/${post.slug}` },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.excerpt}
  ogImage={`/og/writing/${post.slug}.png`}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl">
    <a href="/writing" class="text-sm font-medium text-[var(--color-accent)] hover:underline"
      >← All writing</a
    >
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{data.title}</h1>
    <p class="mt-2 text-sm text-[var(--color-fg-muted)]">
      {data.publishDate.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
    </p>
    <div class="prose prose-slate mt-8 max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
