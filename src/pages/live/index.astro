---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Live Data"
  description="Real, running data pipelines — scheduled ingestion, a bronze/silver/gold transform, monitored data quality, and a documented public API."
>
  <h1 class="text-3xl font-semibold tracking-tight">Live Data</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-fg-muted)]">
    Real, scheduled pipelines — bronze → silver → gold → documented API. Each card below
    fetches live from that pipeline's own API right now; if a pipeline isn't deployed yet, it
    says so rather than showing a screenshot pretending otherwise.
  </p>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2">
    <li>
      <a
        href="/live/carbon"
        class="block rounded-lg border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-accent)]"
      >
        <h2 class="font-semibold">UK Grid Carbon Intensity</h2>
        <p class="mt-2 text-sm text-[var(--color-fg-muted)]">
          Every 30 minutes via Cloudflare Cron Trigger. Bronze → silver → gold → public API.
        </p>
        <span class="mt-3 inline-block text-sm font-medium text-[var(--color-accent)]">View pipeline →</span>
      </a>
    </li>
    <li class="rounded-lg border border-dashed border-[var(--color-border)] p-6 text-[var(--color-fg-muted)]">
      <h2 class="font-semibold">UK House Price Data</h2>
      <p class="mt-2 text-sm">Monthly ingestion — build in progress.</p>
    </li>
    <li class="rounded-lg border border-dashed border-[var(--color-border)] p-6 text-[var(--color-fg-muted)]">
      <h2 class="font-semibold">Site Meta-Pipeline</h2>
      <p class="mt-2 text-sm">Self-referential build/deploy + analytics ingestion — build in progress.</p>
    </li>
  </ul>
</BaseLayout>
