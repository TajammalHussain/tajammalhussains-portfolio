---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Panel from "@/components/Panel.astro";
---

<BaseLayout
  title="Live Data"
  description="Real, running data pipelines — scheduled ingestion, a bronze/silver/gold transform, monitored data quality, and a documented public API."
>
  <h1 class="text-3xl font-semibold tracking-tight">Live Data</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-fg-muted)]">
    Real, scheduled pipelines — bronze → silver → gold → documented API. Each card below
    fetches live from that pipeline's own API right now; if a pipeline isn't deployed yet, it
    says so rather than showing a screenshot pretending otherwise.
  </p>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2">
    <li>
      <a
        href="/live/carbon"
        class="group block transition-transform duration-150 hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
      >
        <Panel eyebrow="UK grid carbon intensity" stages={["bronze", "silver", "gold", "api"]}>
          <p class="text-sm text-slate-300">Every 30 minutes via Cloudflare Cron Trigger.</p>
          <span class="mt-3 inline-block font-mono text-xs text-sky-300 group-hover:underline">
            View pipeline →
          </span>
        </Panel>
      </a>
    </li>
    <li>
      <a
        href="/live/housing"
        class="group block transition-transform duration-150 hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
      >
        <Panel eyebrow="UK house price data" stages={["bronze", "silver", "gold", "api"]}>
          <p class="text-sm text-slate-300">Monthly via Cloudflare Cron Trigger, 14 UK regions.</p>
          <span class="mt-3 inline-block font-mono text-xs text-sky-300 group-hover:underline">
            View pipeline →
          </span>
        </Panel>
      </a>
    </li>
    <li>
      <a
        href="/live/meta"
        class="group block transition-transform duration-150 hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
      >
        <Panel eyebrow="site meta-pipeline" stages={["bronze", "silver", "api"]}>
          <p class="text-sm text-slate-300">
            Daily self-referential snapshot, plus real deploy/build events from CI.
          </p>
          <span class="mt-3 inline-block font-mono text-xs text-sky-300 group-hover:underline">
            View pipeline →
          </span>
        </Panel>
      </a>
    </li>
  </ul>
</BaseLayout>
