---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MermaidDiagram from "@/components/MermaidDiagram.astro";
import HousingLiveWidget from "@/components/HousingLiveWidget.astro";
---

<BaseLayout
  title="UK House Price Data — Live Pipeline"
  description="A real, scheduled Cloudflare Worker pipeline ingesting HM Land Registry's UK House Price Index monthly, through bronze, silver and gold layers, served by a documented public API."
>
  <div class="mx-auto max-w-3xl">
    <a href="/live" class="text-sm font-medium text-[var(--color-accent)] hover:underline"
      >← All pipelines</a
    >
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">UK House Price Data</h1>
    <p class="mt-3 text-lg text-[var(--color-fg-muted)]">
      Ingests HM Land Registry's
      <a href="https://landregistry.data.gov.uk/app/ukhpi" class="text-[var(--color-accent)] underline underline-offset-2">UK House Price Index</a>
      monthly via a Cloudflare Cron Trigger, across 14 UK regions, through a bronze → silver → gold
      pipeline, served by the same documented public API as Pipeline 1.
    </p>

    <HousingLiveWidget />

    <section class="mt-12">
      <h2 class="text-xl font-semibold">Architecture</h2>
      <MermaidDiagram
        chart={`flowchart LR
  A[landregistry.data.gov.uk] -->|monthly\ncron trigger| B[Bronze\nraw JSON to R2]
  B --> C[Silver\nper region + property type]
  C --> D[Gold\nregional MoM / YoY change]
  D --> E[Public API\n/api/v1/housing/*]
  E --> F[This page\nChart.js island]
  C -.-> Q[Data quality checks\nfreshness, completeness,\nvalidity, uniqueness, referential]`}
      />
    </section>

    <section class="mt-10 grid gap-6 sm:grid-cols-2">
      <div class="rounded-lg border border-[var(--color-border)] p-5">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-fg-muted)]">
          Schedule
        </h3>
        <p class="mt-2">Monthly, 1st at 06:00 UTC (<code>0 6 1 * *</code>)</p>
      </div>
      <div class="rounded-lg border border-[var(--color-border)] p-5">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--color-fg-muted)]">
          Source code
        </h3>
        <p class="mt-2">
          <a
            href="https://github.com/TajammalHussain/tajammalhussains-portfolio/tree/main/worker/src/pipelines/housing"
            class="text-[var(--color-accent)] hover:underline"
          >
            worker/src/pipelines/housing on GitHub →
          </a>
        </p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Publication lag &amp; finding the latest month</h2>
      <p class="mt-2 text-[var(--color-fg-muted)]">
        HM Land Registry publishes the UK HPI roughly two months after the reference month closes,
        and the exact lag varies. Each run probes backward from the current month until it finds
        one that's actually published — every probe, hit or miss, is logged to bronze, so the
        audit trail shows exactly what was checked, not just what was found.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Data quality &amp; pipeline runs</h2>
      <p class="mt-2 text-[var(--color-fg-muted)]">
        Full check history and run log: see <a href="/status" class="text-[var(--color-accent)] underline underline-offset-2">/status</a>.
      </p>
    </section>
  </div>
</BaseLayout>
