---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/lib/site";
import {
  SUMMARY,
  EXPERIENCE,
  PORTFOLIO_PROJECTS,
  EDUCATION,
  CERTIFICATIONS,
  SKILLS,
  ADDITIONAL_INFO,
} from "@/lib/cv";
import { getEntry } from "astro:content";

const settings = await getEntry("site-settings", "site");
const cvPdfPath = settings?.data.cvPdfPath ?? "/cv/Tajammal-Hussain-CV.pdf";
---

<BaseLayout
  title="CV"
  description="On-page CV for Tajammal Hussain — Data Engineer with four years of experience in data pipelines, automation, BI and full-stack development. Downloadable PDF version available."
>
  <div class="mx-auto max-w-3xl">
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight">CV</h1>
      <div class="flex gap-3">
        <a
          href={cvPdfPath}
          download
          class="rounded-md bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-fg)] hover:opacity-90"
        >
          Download PDF
        </a>
        <button
          type="button"
          onclick="window.print()"
          class="rounded-md border border-[var(--color-border)] px-5 py-2.5 text-sm font-semibold hover:border-[var(--color-accent)]"
        >
          Print
        </button>
      </div>
    </div>

    <!-- Semantic, ATS-friendly CV body — deliberately plain markup, styling
         layered on top rather than baked into the structure. -->
    <article id="cv-document" class="rounded-lg border border-[var(--color-border)] p-8 print:border-none print:p-0">
      <header>
        <h2 class="text-2xl font-bold">{SITE.name}</h2>
        <p class="text-[var(--color-fg-muted)]">
          {SITE.headline} · {SITE.location}
        </p>
        <p class="mt-1 text-sm text-[var(--color-fg-muted)]">
          <a href={SITE.sameAs[1]} class="underline underline-offset-2">{SITE.sameAs[1]}</a> ·
          <a href={SITE.sameAs[0]} class="underline underline-offset-2">{SITE.sameAs[0]}</a>
        </p>
      </header>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">Professional Profile</h3>
        <p class="mt-2">{SUMMARY}</p>
      </section>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">Professional Experience</h3>
        <div class="mt-3 space-y-5">
          {
            EXPERIENCE.map((job) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <p class="font-semibold">{job.title}</p>
                  <p class="text-sm italic text-[var(--color-fg-muted)]">{job.period}</p>
                </div>
                <p class="text-sm italic text-[var(--color-fg-muted)]">
                  {job.organisation}, {job.location}
                </p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                  {job.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">Portfolio — {SITE.url.replace("https://", "")}</h3>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          {
            PORTFOLIO_PROJECTS.map((p) => (
              <li>
                <a href={p.href} class="font-medium underline underline-offset-2">{p.name}</a>: {p.detail}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">Education</h3>
        <div class="mt-3 space-y-4">
          {
            EDUCATION.map((e) => (
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <p class="font-semibold">
                    {e.qualification} — {e.grade}
                  </p>
                  <p class="text-sm italic text-[var(--color-fg-muted)]">{e.period}</p>
                </div>
                <p class="text-sm italic text-[var(--color-fg-muted)]">{e.institution}</p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">Technical Skills</h3>
        <dl class="mt-2 space-y-1 text-sm">
          {
            SKILLS.map((s) => (
              <div>
                <dt class="inline font-semibold">{s.group}: </dt>
                <dd class="inline">{s.items.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">Professional Certifications</h3>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          {
            CERTIFICATIONS.map((c) => (
              <li>
                {c.name}
                {c.issuer && ` — ${c.issuer}`}
                {c.detail && ` (${c.detail})`}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">Additional Information</h3>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          {ADDITIONAL_INFO.map((i) => <li>{i}</li>)}
          <li>
            Live project portfolio: <a href="/work" class="underline underline-offset-2">{SITE.url.replace("https://", "")}</a> — deployed pipelines, full-stack applications, and documented case studies.
          </li>
        </ul>
      </section>

      <section class="mt-6">
        <h3 class="text-sm font-bold uppercase tracking-wide">References</h3>
        <p class="mt-2 text-sm">Available upon request.</p>
      </section>
    </article>

    <p class="no-print mt-6 text-xs text-[var(--color-fg-muted)]">
      Prefer a file? "Download PDF" fetches a pre-generated PDF from {cvPdfPath}. "Print" uses
      your browser's print dialog against this same page, styled for paper.
    </p>
  </div>
</BaseLayout>

<style>
  @media print {
    #cv-document a {
      color: inherit;
      text-decoration: none;
    }
    #cv-document a[href^="http"]::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: #555;
    }
  }
</style>
