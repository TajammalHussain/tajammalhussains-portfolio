---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const caseStudies = await getCollection(
    "case-studies",
    (entry: CollectionEntry<"case-studies">) => !entry.data.draft,
  );
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { caseStudy: cs },
  }));
}

const { caseStudy } = Astro.props;
const { Content } = await render(caseStudy);
const { data } = caseStudy;
const slug = caseStudy.slug;

const sections: Array<[string, string]> = [
  ["Problem", data.problem],
  ["Constraints", data.constraints],
  ["Approach", data.approach],
  ["Outcome", data.outcome],
  ["What I'd do differently", data.retrospective],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Work", item: "/work" },
      { "@type": "ListItem", position: 2, name: data.title, item: `/work/${slug}` },
    ],
  },
];
---

<BaseLayout title={data.title} description={data.summary} ogImage={`/og/work/${slug}.png`} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl">
    <a href="/work" class="text-sm font-medium text-[var(--color-accent)] hover:underline"
      >← All case studies</a
    >
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">{data.title}</h1>
    <p class="mt-3 text-lg text-[var(--color-fg-muted)]">{data.summary}</p>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      {
        data.stack.map((tag) => (
          <span class="rounded-full bg-[var(--color-bg-subtle)] px-2.5 py-1 text-xs text-[var(--color-fg-muted)]">
            {tag}
          </span>
        ))
      }
      {
        data.readingTimeMinutes && (
          <span class="ml-auto text-xs text-[var(--color-fg-muted)]">
            {data.readingTimeMinutes} min read
          </span>
        )
      }
    </div>

    <div class="prose prose-slate mt-10 max-w-none dark:prose-invert">
      {
        sections.map(([heading, body]) => (
          <section class="mb-8">
            <h2 class="text-xl font-semibold">{heading}</h2>
            <p class="mt-2 whitespace-pre-line text-[var(--color-fg-muted)]">{body}</p>
          </section>
        ))
      }
      <Content />
    </div>
  </article>
</BaseLayout>
