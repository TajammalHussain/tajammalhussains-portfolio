---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const caseStudies = (
  await getCollection(
    "case-studies",
    (entry: CollectionEntry<"case-studies">) => !entry.data.draft,
  )
).sort(
  (a: CollectionEntry<"case-studies">, b: CollectionEntry<"case-studies">) =>
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Case Studies"
  description="Six case studies covering approval workflows, compliance systems, asset tracking, attendance consolidation, automated alerting, and large-scale data extraction."
>
  <h1 class="text-3xl font-semibold tracking-tight">Case Studies</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-fg-muted)]">
    Each one follows the same shape: problem, constraints, approach, architecture, stack,
    outcome — and what I'd do differently now. Internal, employer-proprietary implementation
    detail is intentionally left out; the engineering decisions are not.
  </p>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2">
    {
      caseStudies.map((cs) => (
        <li>
          <a
            href={`/work/${cs.slug}`}
            class="flex h-full flex-col rounded-lg border border-[var(--color-border)] p-6 transition-colors hover:border-[var(--color-accent)]"
          >
            <h2 class="font-semibold">{cs.data.title}</h2>
            <p class="mt-2 flex-1 text-sm text-[var(--color-fg-muted)]">{cs.data.summary}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {cs.data.stack.map((tag) => (
                <span class="rounded-full bg-[var(--color-bg-subtle)] px-2.5 py-1 text-xs text-[var(--color-fg-muted)]">
                  {tag}
                </span>
              ))}
            </div>
            {cs.data.readingTimeMinutes && (
              <p class="mt-4 text-xs text-[var(--color-fg-muted)]">
                {cs.data.readingTimeMinutes} min read
              </p>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
