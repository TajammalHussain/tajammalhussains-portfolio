---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CarbonLiveWidget from "@/components/CarbonLiveWidget.astro";
import Panel from "@/components/Panel.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { SITE } from "@/lib/site";

const settings = await getEntry("site-settings", "site");
const allCaseStudies = await getCollection(
  "case-studies",
  (entry: CollectionEntry<"case-studies">) => !entry.data.draft,
);
const featured = allCaseStudies
  .filter((cs) => cs.data.featured)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const heroHeading = settings?.data.heroHeading ?? SITE.tagline;
const heroBody = settings?.data.heroBody ?? SITE.description;

const firstSentence = (s: string) => s.trim().split(/(?<=[.!?])\s/)[0];
---

<BaseLayout title="Home">
  <section class="grid gap-10 py-8 sm:py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-12">
    <div class="flex flex-col gap-6">
      <p class="text-sm font-medium uppercase tracking-wide text-[var(--color-accent)]">
        {SITE.jobTitle} → {SITE.targetRole} · {SITE.location}
      </p>
      <h1 class="max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        {heroHeading}
      </h1>
      <p class="max-w-xl text-lg text-[var(--color-fg-muted)]">
        {heroBody}
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/live"
          class="rounded-md bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-fg)] transition-opacity hover:opacity-90"
        >
          Watch it work →
        </a>
        <a
          href="/work"
          class="rounded-md border border-[var(--color-border)] px-5 py-2.5 text-sm font-semibold transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          View case studies
        </a>
      </div>
    </div>

    <Panel eyebrow="UK grid carbon intensity" stages={["bronze", "silver", "gold", "api"]}>
      <div class="flex items-center gap-2">
        <span id="hero-live-dot" class="hidden h-2 w-2 rounded-full bg-emerald-400"></span>
        <span id="hero-live-status" class="font-mono text-xs tracking-wide text-slate-400">
          checking feed…
        </span>
      </div>
      <p id="hero-live-value" class="mt-3 font-mono text-2xl font-semibold text-sky-300">—</p>
      <p id="hero-live-freshness" class="mt-1 font-mono text-xs text-slate-500"></p>
    </Panel>
  </section>

  <section aria-labelledby="live-teaser-heading" class="border-t border-[var(--color-border)] py-12">
    <div class="flex items-baseline justify-between">
      <h2 id="live-teaser-heading" class="text-xl font-semibold">Full pipeline detail</h2>
      <a href="/live" class="text-sm font-medium text-[var(--color-accent)] hover:underline">
        All pipelines →
      </a>
    </div>
    <p class="mt-2 max-w-2xl text-[var(--color-fg-muted)]">
      Same pipeline as the panel above, in full: a scheduled Cloudflare Worker pulls UK grid carbon
      intensity every 30 minutes, lands it raw, transforms it through a bronze → silver → gold
      pipeline, and serves it from a documented public API. The chart below is real, not a
      screenshot.
    </p>
    <div class="mt-6">
      <CarbonLiveWidget />
    </div>
  </section>

  {
    featured.length > 0 && (
      <section aria-labelledby="featured-work-heading" class="border-t border-[var(--color-border)] py-12">
        <div class="flex items-baseline justify-between">
          <h2 id="featured-work-heading" class="text-xl font-semibold">
            Featured work
          </h2>
          <a href="/work" class="text-sm font-medium text-[var(--color-accent)] hover:underline">
            All case studies →
          </a>
        </div>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {featured.map((cs) => (
            <li>
              <a
                href={`/work/${cs.slug}`}
                class="card-hover group block rounded-lg border border-[var(--color-border)] p-5"
              >
                <h3 class="font-semibold">{cs.data.title}</h3>
                <p class="mt-2 text-sm text-[var(--color-fg-muted)]">{cs.data.summary}</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {cs.data.stack.slice(0, 4).map((tag) => (
                    <li class="rounded-full bg-[var(--color-bg-subtle)] px-2.5 py-1 text-xs text-[var(--color-fg-muted)]">
                      {tag}
                    </li>
                  ))}
                </ul>
                <p
                  class="mt-0 max-h-0 overflow-hidden font-mono text-xs text-[var(--color-data)] opacity-0 transition-all duration-200 group-hover:mt-3 group-hover:max-h-12 group-hover:border-t group-hover:border-dashed group-hover:border-[var(--color-border)] group-hover:pt-3 group-hover:opacity-100 group-focus-visible:mt-3 group-focus-visible:max-h-12 group-focus-visible:border-t group-focus-visible:border-dashed group-focus-visible:border-[var(--color-border)] group-focus-visible:pt-3 group-focus-visible:opacity-100"
                >
                  ↳ {firstSentence(cs.data.outcome)}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <script>
    // Slim companion to CarbonLiveWidget's fetch: just the current reading,
    // for the hero panel above the fold. Same graceful-degradation rule —
    // never claim "live" without a fresh, successful fetch backing it.
    async function initHeroLiveStatus() {
      const apiBase = (import.meta.env.PUBLIC_API_BASE_URL as string | undefined) ?? "http://localhost:8787";
      const dotEl = document.getElementById("hero-live-dot");
      const statusEl = document.getElementById("hero-live-status");
      const valueEl = document.getElementById("hero-live-value");
      const freshnessEl = document.getElementById("hero-live-freshness");
      if (!statusEl || !valueEl || !freshnessEl || !dotEl) return;

      try {
        const res = await fetch(`${apiBase}/api/v1/carbon/current`);
        if (!res.ok) throw new Error(`API returned ${res.status}`);
        const { data: current } = await res.json();

        const periodTo = new Date(current.periodTo.replace("Z", "") + "Z");
        const ageMinutes = (Date.now() - periodTo.getTime()) / 60_000;

        valueEl.textContent =
          current.actualIntensity !== null
            ? `${current.actualIntensity} gCO₂/kWh`
            : `~${current.forecastIntensity} gCO₂/kWh (forecast)`;

        if (ageMinutes > 90) {
          statusEl.textContent = `stale · ${Math.round(ageMinutes)}m old`;
          statusEl.classList.add("text-amber-400");
        } else {
          dotEl.classList.remove("hidden");
          dotEl.classList.add("animate-pulse");
          statusEl.textContent = "live";
          statusEl.classList.add("text-emerald-400");
        }
        freshnessEl.textContent = `updated ${Math.round(ageMinutes)}m ago`;
      } catch {
        statusEl.textContent = "feed unreachable";
        freshnessEl.textContent = "pipeline may not be deployed yet — see /live";
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeroLiveStatus);
    } else {
      initHeroLiveStatus();
    }
  </script>
</BaseLayout>
