---
import BaseLayout from "@/layouts/BaseLayout.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "https://api.tajammalhussains.uk";

const endpoints = [
  {
    method: "GET",
    path: "/api/v1/health",
    description: "Liveness check — confirms the database is reachable.",
    example: `{ "status": "ok", "time": "2026-01-01T12:00:00.000Z" }`,
  },
  {
    method: "GET",
    path: "/api/v1/carbon/current",
    description: "The most recent half-hourly UK grid carbon intensity reading, plus generation mix for that period.",
    example: `{
  "data": {
    "periodFrom": "2026-01-01T12:00Z",
    "periodTo": "2026-01-01T12:30Z",
    "actualIntensity": 61,
    "forecastIntensity": 52,
    "indexBand": "low",
    "generationMix": [{ "fuel_type": "wind", "percentage": 26.6 }]
  },
  "cacheHit": false
}`,
  },
  {
    method: "GET",
    path: "/api/v1/carbon/history?from=YYYY-MM-DD&to=YYYY-MM-DD&granularity=daily|raw",
    description: "Historical readings. `daily` returns gold aggregates (one row per day); `raw` returns every silver reading in range.",
    example: `{ "data": [{ "date": "2026-01-01", "avg_actual_intensity": 61.2, "reading_count": 48 }] }`,
  },
  {
    method: "GET",
    path: "/api/v1/carbon/mix?date=YYYY-MM-DD",
    description: "Generation mix (fuel type shares) for a given date, or the most recent date if omitted.",
    example: `{ "data": { "date": "2026-01-01", "mix": [{ "fuel_type": "wind", "avg_share": 26.6 }] } }`,
  },
  {
    method: "GET",
    path: "/api/v1/housing/regional?region=",
    description: "Regional UK house price aggregates (HM Land Registry UK HPI, monthly) — 14 UK regions, average price plus month-on-month and year-on-year change. Omit `region` for the latest snapshot across all regions.",
    example: `{
  "data": [
    {
      "period": "2026-06",
      "region": "london",
      "average_price": 553870,
      "mom_change_pct": null,
      "yoy_change_pct": null,
      "computed_at": "2026-08-25 07:47:33"
    }
  ]
}`,
  },
  {
    method: "GET",
    path: "/api/v1/meta/events?limit=",
    description: "The site meta-pipeline's own event log — daily self-referential snapshots of every other pipeline's health, plus real deploy/build events reported by CI.",
    example: `{
  "data": [
    {
      "id": 1,
      "eventType": "analytics_snapshot",
      "occurredAt": "2026-08-25T08:04:00.446Z",
      "detail": {
        "pipelineRunCounts": { "carbon": { "success": 3, "failed": 0, "running": 0 } },
        "qualityCheckFailures24h": 0,
        "totalAuditActions": 6,
        "bronzeObjectsTotal": 22
      }
    }
  ]
}`,
  },
  {
    method: "GET",
    path: "/api/v1/pipelines/status",
    description: "Every pipeline's config, last run, and most recent data-quality check results.",
    example: `{ "data": [{ "pipeline": "carbon", "paused": false, "lastRun": { "status": "success" } }] }`,
  },
];
---

<BaseLayout
  title="Public API"
  description="Documented, read-only public API for pipeline data — endpoints, examples, caching, and rate limits."
>
  <h1 class="text-3xl font-semibold tracking-tight">Public API</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-fg-muted)]">
    Every endpoint below is read-only (GET), CORS-enabled, and backed by the same D1 tables shown
    on <a href="/status" class="text-[var(--color-accent)] underline underline-offset-2">/status</a>. Base
    URL: <code class="rounded bg-[var(--color-bg-subtle)] px-1.5 py-0.5">{apiBase}</code>
  </p>

  <section class="mt-8 rounded-lg border border-[var(--color-border)] p-5">
    <h2 class="font-semibold">Caching &amp; rate limits</h2>
    <ul class="mt-3 list-inside list-disc space-y-1 text-sm text-[var(--color-fg-muted)]">
      <li>Responses are cached in Cloudflare KV for 5 minutes by default; the response body includes <code>cacheHit</code> so you can tell.</li>
      <li>60 requests per minute per IP address. Exceeding this returns <code>429</code>.</li>
      <li>No API key required — this is a public, read-only API.</li>
    </ul>
  </section>

  <div class="mt-10 space-y-6">
    {
      endpoints.map((e) => (
        <div class="rounded-lg border border-[var(--color-border)] p-5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded bg-[var(--color-accent)] px-2 py-0.5 text-xs font-bold text-[var(--color-accent-fg)]">
              {e.method}
            </span>
            <code class="text-sm">{e.path}</code>
          </div>
          <p class="mt-2 text-sm text-[var(--color-fg-muted)]">{e.description}</p>
          <pre
            tabindex="0"
            role="region"
            aria-label={`Example response for ${e.method} ${e.path}`}
            class="mt-3 overflow-x-auto rounded-md bg-[var(--color-bg-subtle)] p-3 text-xs"
          ><code>{e.example}</code></pre>
        </div>
      ))
    }
  </div>
</BaseLayout>
