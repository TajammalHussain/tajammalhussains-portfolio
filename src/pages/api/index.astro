---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="API"
  description="Documented, read-only public API for pipeline data — endpoints, examples, caching, and rate limits."
>
  <h1 class="text-3xl font-semibold tracking-tight">Public API</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-fg-muted)]">
    Full endpoint documentation, example requests/responses, rate limits, and caching policy
    will appear here once the API Worker is deployed.
  </p>
  <div class="mt-10 rounded-lg border border-dashed border-[var(--color-border)] p-8 text-center text-[var(--color-fg-muted)]">
    <p class="font-medium">API not deployed yet.</p>
  </div>
</BaseLayout>
