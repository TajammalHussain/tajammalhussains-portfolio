---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdminOpsDashboard from "@/components/AdminOpsDashboard.astro";
---

<BaseLayout
  title="Operations"
  description="Internal pipeline control and monitoring dashboard."
  noIndex={true}
>
  <h1 class="text-3xl font-semibold tracking-tight">Operations</h1>
  <p class="mt-3 max-w-2xl text-[var(--color-fg-muted)]">
    Pipeline control, monitoring, data inspection, and the admin audit trail. This page is gated by
    Cloudflare Access — nothing here is reachable without SSO, and every action taken from it is
    written to an immutable audit log.
  </p>
  <div class="mt-10">
    <AdminOpsDashboard />
  </div>
</BaseLayout>
