---
import { SITE } from "@/lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)]">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-10 text-sm text-[var(--color-fg-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>&copy; {year} {SITE.name}. {SITE.location}.</p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
      <a href="/status" class="hover:text-[var(--color-accent)]">System Status</a>
      <a href="/api" class="hover:text-[var(--color-accent)]">API</a>
      <a href="/uses" class="hover:text-[var(--color-accent)]">Uses</a>
      <a href="/ventures" class="hover:text-[var(--color-accent)]">Ventures</a>
      <a href={SITE.sameAs[1]} class="hover:text-[var(--color-accent)]" rel="me">GitHub</a>
      <a href={SITE.sameAs[0]} class="hover:text-[var(--color-accent)]" rel="me">LinkedIn</a>
    </nav>
  </div>
</footer>
