---
// Include once per layout (see BaseLayout.astro). Does nothing — and fetches
// nothing — on pages with no .mermaid[data-chart] nodes, so this stays
// effectively free on every page that doesn't render a diagram.
---

<script>
  function initMermaid() {
    const nodes = document.querySelectorAll<HTMLElement>(".mermaid[data-chart]");
    if (nodes.length === 0) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        const anyVisible = entries.some((e) => e.isIntersecting);
        if (!anyVisible) return;
        obs.disconnect();
        import("mermaid")
          .then(({ default: mermaid }) => {
            const isDark = document.documentElement.dataset.theme === "dark";
            mermaid.initialize({
              startOnLoad: false,
              theme: isDark ? "dark" : "default",
              securityLevel: "strict",
            });
            nodes.forEach((n) => {
              n.textContent = n.dataset.chart ?? "";
            });
            return mermaid.run({ nodes: Array.from(nodes) });
          })
          .catch((err) => {
            console.error("mermaid render failed", err);
          });
      },
      { rootMargin: "200px" },
    );

    nodes.forEach((n) => observer.observe(n));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMermaid);
  } else {
    initMermaid();
  }
</script>
