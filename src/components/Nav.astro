---
import { NAV_LINKS } from "@/lib/site";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-[var(--color-border)]">
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6"
  >
    <a
      href="/"
      class="font-semibold tracking-tight text-[var(--color-fg)] hover:text-[var(--color-accent)]"
    >
      Tajammal Hussain
    </a>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-links"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border)] sm:hidden"
      aria-label="Toggle navigation menu"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <div
      id="nav-links"
      class="absolute left-0 right-0 top-[65px] hidden flex-col gap-1 border-b border-[var(--color-border)] bg-[var(--color-bg)] p-4 sm:static sm:flex sm:flex-row sm:items-center sm:gap-6 sm:border-none sm:bg-transparent sm:p-0"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "text-sm font-medium transition-colors hover:text-[var(--color-accent)]",
              isActive(link.href) ? "text-[var(--color-accent)]" : "text-[var(--color-fg-muted)]",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");
  toggle?.addEventListener("click", () => {
    const isOpen = links?.classList.toggle("flex");
    links?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
