---
// Lazy-loaded island: mermaid.js is only fetched on pages that actually
// render a diagram, and only once it scrolls near the viewport — keeps the
// zero-JS-by-default promise intact everywhere else on the site.
interface Props {
  chart: string;
  id?: string;
}
const { chart, id = `mermaid-${Math.random().toString(36).slice(2, 9)}` } = Astro.props;
---

<div class="mermaid-wrapper not-prose my-8 overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4">
  <pre class="mermaid" id={id} data-chart={chart}>{chart}</pre>
</div>

<script>
  // One shared IntersectionObserver + one dynamic import for the whole page,
  // however many diagrams it contains.
  function initMermaid() {
    const nodes = document.querySelectorAll<HTMLElement>(".mermaid[data-chart]");
    if (nodes.length === 0) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        const anyVisible = entries.some((e) => e.isIntersecting);
        if (!anyVisible) return;
        obs.disconnect();
        import("mermaid").then(({ default: mermaid }) => {
          const isDark = document.documentElement.dataset.theme === "dark";
          mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? "dark" : "default",
            securityLevel: "strict",
          });
          nodes.forEach((n) => {
            n.textContent = n.dataset.chart ?? "";
          });
          mermaid.run({ nodes: Array.from(nodes) });
        });
      },
      { rootMargin: "200px" },
    );

    nodes.forEach((n) => observer.observe(n));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMermaid);
  } else {
    initMermaid();
  }
</script>
