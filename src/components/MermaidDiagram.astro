---
// Rendered to static SVG at build time (see src/lib/mermaid-render.ts) —
// previously this shipped the ~680KB Mermaid runtime to the browser to draw
// what is, on this site, always static content; Lighthouse's performance
// audit caught the real cost of that (683KB, 68% unused, ~800ms bootup on
// every page with a diagram). No client-side JS runtime is needed anymore.
import { renderMermaidToSvg } from "@/lib/mermaid-render";

interface Props {
  chart: string;
}
const { chart } = Astro.props;
const svg = await renderMermaidToSvg(chart);
---

<div
  class="mermaid-wrapper not-prose my-8 overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4 [&_svg]:mx-auto"
  tabindex="0"
  role="img"
  aria-label="Architecture diagram"
  set:html={svg}
/>
