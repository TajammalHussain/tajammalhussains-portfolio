---
// Branded pill buttons (icon + label, brand-colour background, hover lift) —
// styled after https://hennabyeish.uk/'s social buttons, per the owner's
// request, adapted with two real fixes: Facebook's exact brand blue
// (#1877F2) and Instagram's stock yellow→pink→purple gradient both fail
// WCAG AA contrast (4.5:1) against the white icon/label text — 4.23:1 and as
// low as 1.51:1 at the yellow stop, respectively. Swapped for a slightly
// darker blue and a yellow-free pink→purple gradient that hold >=5.2:1
// across the whole gradient, verified by sampling it at 25% steps — same
// recognisable brand feel, but this site's own accessibility bar (zero
// axe-core violations, checked in tests/e2e/accessibility.spec.ts) doesn't
// bend for a reference design.
import { SOCIAL_LINKS } from "@/lib/site";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

