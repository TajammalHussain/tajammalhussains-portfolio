const BRAND_BG: Record<(typeof SOCIAL_LINKS)[number]["platform"], string> = {
  linkedin: "#0A66C2",
  github: "#181717",
  facebook: "#0C55B8", // darkened from Facebook's #1877F2 — see contrast note above
  instagram: "linear-gradient(135deg, #C7238A, #6228D7)", // yellow stop dropped — see contrast note above
  tiktok: "#000000",
  x: "#000000",
};
---

<ul class:list={["flex flex-wrap gap-3", className]}>
  {
    SOCIAL_LINKS.map((s) => (
      <li>
        <a
          href={s.url}
          target="_blank"
          rel="me noopener noreferrer"
          class="social-pill"
          style={`background:${BRAND_BG[s.platform]}`}
          aria-label={`${s.label} (opens in a new tab)`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={ICON_PATHS[s.platform]} />
          </svg>
          <span>{s.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.85rem;
    color: #fff;
    box-shadow: 0 6px 18px rgb(0 0 0 / 18%);
    border: 1px solid rgb(255 255 255 / 10%);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .social-pill:hover,
  .social-pill:focus-visible {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 24px rgb(0 0 0 / 28%);
  }
  .social-pill svg {
    width: 18px;
    height: 18px;
    fill: #fff;
    flex-shrink: 0;
  }
</style>
