---
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<div id="status-widget" data-api-base={apiBase}>
  <div id="status-loading" class="text-sm text-[var(--color-fg-muted)]">Loading pipeline status…</div>
  <div id="status-error" class="hidden text-sm text-[var(--color-danger)]"></div>
  <div id="status-content" class="hidden space-y-6"></div>
</div>

<script>
  interface QualityCheck {
    check_name: string;
    status: "pass" | "fail";
    run_at: string;
  }
  interface PipelineStatus {
    pipeline: string;
    paused: boolean;
    visibleOnLivePage: boolean;
    stalenessThresholdMinutes: number;
    lastRun: {
      status: string;
      started_at: string;
      finished_at: string | null;
      rows_silver: number | null;
      rows_gold: number | null;
    } | null;
    latestQualityChecks: QualityCheck[];
  }

  const PIPELINE_LABELS: Record<string, string> = {
    carbon: "UK Grid Carbon Intensity",
    housing: "UK House Price Data",
    meta: "Site Meta-Pipeline",
  };

  function statusBadge(status: "pass" | "fail" | "success" | "failed" | "running") {
    const isPass = status === "pass" || status === "success";
    const isRunning = status === "running";
    const cls = isRunning
      ? "bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300"
      : isPass
        ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
        : "bg-red-50 text-red-700 dark:bg-red-950 dark:text-red-300";
    return `<span class="rounded-full px-2.5 py-1 text-xs font-semibold ${cls}">${status}</span>`;
  }

  async function initStatusWidget() {
    const root = document.getElementById("status-widget");
    if (!root) return;
    const apiBase = root.dataset.apiBase ?? "";
    const loadingEl = document.getElementById("status-loading")!;
    const errorEl = document.getElementById("status-error")!;
    const contentEl = document.getElementById("status-content")!;

    try {
      const res = await fetch(`${apiBase}/api/v1/pipelines/status`);
      if (!res.ok) throw new Error(`API returned ${res.status}`);
      const { data }: { data: PipelineStatus[] } = await res.json();

      loadingEl.classList.add("hidden");
      contentEl.classList.remove("hidden");

      contentEl.innerHTML = data
        .map((p) => {
          const label = PIPELINE_LABELS[p.pipeline] ?? p.pipeline;
          const runStatus = p.lastRun?.status ?? "never run";
          const checksHtml = p.latestQualityChecks.length
            ? `<ul class="mt-3 grid gap-2 sm:grid-cols-2">${p.latestQualityChecks
                .map(
                  (c) =>
                    `<li class="flex items-center justify-between rounded-md border border-[var(--color-border)] px-3 py-2 text-sm"><span class="capitalize">${c.check_name}</span>${statusBadge(c.status)}</li>`,
                )
                .join("")}</ul>`
            : `<p class="mt-3 text-sm text-[var(--color-fg-muted)]">No quality checks recorded yet.</p>`;

          return `
            <div class="rounded-lg border border-[var(--color-border)] p-5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="font-semibold">${label}</h3>
                <div class="flex items-center gap-2">
                  ${p.paused ? '<span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-950 dark:text-amber-300">paused</span>' : ""}
                  ${statusBadge(runStatus as "pass" | "fail" | "success" | "failed" | "running")}
                </div>
              </div>
              <dl class="mt-3 grid grid-cols-2 gap-2 text-sm text-[var(--color-fg-muted)] sm:grid-cols-4">
                <div><dt class="text-xs uppercase">Last run</dt><dd>${p.lastRun ? new Date(p.lastRun.started_at.replace(" ", "T") + "Z").toLocaleString("en-GB") : "—"}</dd></div>
                <div><dt class="text-xs uppercase">Rows (silver)</dt><dd>${p.lastRun?.rows_silver ?? "—"}</dd></div>
                <div><dt class="text-xs uppercase">Rows (gold)</dt><dd>${p.lastRun?.rows_gold ?? "—"}</dd></div>
                <div><dt class="text-xs uppercase">Staleness limit</dt><dd>${p.stalenessThresholdMinutes}m</dd></div>
              </dl>
              ${checksHtml}
            </div>`;
        })
        .join("");
    } catch (err) {
      loadingEl.classList.add("hidden");
      errorEl.classList.remove("hidden");
      errorEl.textContent =
        err instanceof Error
          ? `Could not load pipeline status: ${err.message}. The API may not be deployed yet.`
          : "Could not load pipeline status.";
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStatusWidget);
  } else {
    initStatusWidget();
  }
</script>
