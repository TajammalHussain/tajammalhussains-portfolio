{
  "name": "portfolio-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply portfolio_db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply portfolio_db --remote",
    "d1:studio:local": "wrangler d1 execute portfolio_db --local --command \"SELECT name FROM sqlite_master WHERE type='table'\"",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "3.2.4",
    "wrangler": "^3.99.0"
  }
}
